# Secrets are managed via Doppler.
# For local development without Doppler, copy this file to .env and fill in values.
# For Claude Code cloud sessions, set DOPPLER_TOKEN as a Claude env var — secrets are
# injected automatically at session start via the SessionStart hook.

DATABASE_URL=postgres://...
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
VERCEL_TOKEN=
APP_URL=http://localhost:5173
