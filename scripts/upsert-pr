#!/usr/bin/env bash
# Creates or updates the PR for the current branch on GitHub.
# Usage: ./scripts/upsert-pr --title "..." --body "..."

set -euo pipefail

title=""
body=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title) title="$2"; shift 2 ;;
    --body)  body="$2";  shift 2 ;;
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
  esac
done

if [[ -z "$title" ]]; then
  echo "Error: --title is required" >&2
  exit 1
fi

echo "Running lint check…"
npm run lint || { echo "Error: lint failed — fix errors before submitting a PR." >&2; exit 1; }

branch=$(git rev-parse --abbrev-ref HEAD)

if gh pr view "$branch" --json state -q .state &>/dev/null; then
  state=$(gh pr view "$branch" --json state -q .state)
  if [[ "$state" == "MERGED" || "$state" == "CLOSED" ]]; then
    echo "Error: branch '$branch' already has a $state PR." >&2
    echo "Create a new branch before submitting: git checkout -b <new-branch-name>" >&2
    exit 1
  fi
  gh pr edit "$branch" --title "$title" ${body:+--body "$body"}
  echo "Updated PR for branch: $branch"
else
  gh pr create --title "$title" ${body:+--body "$body"} --head "$branch"
  echo "Created PR for branch: $branch"
fi
