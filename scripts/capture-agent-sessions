#!/usr/bin/env bash
# Distills all agent sessions for the current branch into the branch work folder.
# Each session is written as <session-id>.md alongside PLAN.md.

set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "$0")" && pwd)"
BRANCH=$(git -C "$(dirname "$SCRIPTS_DIR")" rev-parse --abbrev-ref HEAD)

if [[ -z "${WORK_FOLDER:-}" ]]; then
  echo "Error: WORK_FOLDER is not set. The SessionStart hook may not have run." >&2
  exit 1
fi

if ! command -v agent-review &>/dev/null; then
  echo "agent-review not found — install it globally first" >&2
  exit 1
fi

SESSIONS=$(agent-review sessions --branch)

if [[ -z "$SESSIONS" ]]; then
  echo "No agent sessions found for branch '$BRANCH'."
  exit 0
fi

while IFS= read -r line; do
  [[ "$line" != \[* ]] && continue
  SESSION_ID=$(echo "$line" | awk '{print $4}')
  [[ -z "$SESSION_ID" ]] && continue
  OUT="$WORK_FOLDER/${SESSION_ID}.md"
  echo "Distilling $SESSION_ID..."
  agent-review distill "$SESSION_ID" > "$OUT"
done <<< "$SESSIONS"

echo "Agent sessions written to $WORK_FOLDER"
