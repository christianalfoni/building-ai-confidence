#!/usr/bin/env bash
# Prints all review comments on the current branch's open PR.
# Output is structured for agent consumption: overall reviews first,
# then numbered inline comments with file path, diff hunk, and body.

set -euo pipefail

REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner)
PR_NUMBER=$(gh pr view --json number -q .number 2>/dev/null)

if [[ -z "$PR_NUMBER" ]]; then
  echo "No open PR found for the current branch." >&2
  exit 1
fi

PR_URL=$(gh pr view --json url -q .url)
echo "# Review comments for PR #${PR_NUMBER}"
echo "${PR_URL}"
echo ""

# Overall reviews (CHANGES_REQUESTED or COMMENTED with a body)
gh pr view "$PR_NUMBER" --json reviews -q '
  .reviews[]
  | select(.body != "" and (.state == "CHANGES_REQUESTED" or .state == "COMMENTED"))
  | "## Overall review by \(.author.login) [\(.state)]\n\(.body)\n"
' 2>/dev/null || true

# Inline comments — write to a temp file so Python can read it without stdin conflict
TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT
gh api "repos/${REPO}/pulls/${PR_NUMBER}/comments" > "$TMPFILE" 2>/dev/null

COUNT=$(python3 -c "import json; print(len(json.load(open('$TMPFILE'))))")

if [[ "$COUNT" -eq 0 ]]; then
  echo "No inline comments."
  exit 0
fi

echo "## Inline comments (${COUNT})"
echo ""

python3 - "$TMPFILE" <<'PYEOF'
import json, sys

comments = json.load(open(sys.argv[1]))
for i, c in enumerate(comments, 1):
    path = c.get("path", "")
    hunk = c.get("diff_hunk", "")
    body = c.get("body", "").strip()
    author = c.get("user", {}).get("login", "unknown")
    url = c.get("html_url", "")

    print(f"### [{i}] {path}")
    print(f"<{url}>")
    print("")
    print("```diff")
    hunk_lines = hunk.splitlines()
    for line in hunk_lines[-8:]:
        print(line)
    print("```")
    print("")
    print(f"**{author}:** {body}")
    print("")
    print("---")
    print("")
PYEOF
