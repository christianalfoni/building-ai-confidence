#!/usr/bin/env bash
# Prints raw-GitHub linked-image markup for one or more screenshots.
# Usage: ./scripts/screenshot-url <name> [<name> ...]
#   e.g. ./scripts/screenshot-url desktop-App-before desktop-App-after
# Screenshot names may include or omit the .png extension.

set -euo pipefail

REPO="christianalfoni/building-ai-confidence"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BRANCH="$(git -C "$ROOT" branch --show-current)"

if [[ $# -eq 0 ]]; then
  echo "Usage: ./scripts/screenshot-url <name> [<name> ...]" >&2
  exit 1
fi

if [[ -z "${WORK_FOLDER:-}" ]]; then
  echo "Error: WORK_FOLDER is not set. The SessionStart hook may not have run." >&2
  exit 1
fi

SCREENSHOTS_REL="$(realpath --relative-to="$ROOT" "$WORK_FOLDER")/screenshots"

for name in "$@"; do
  name="${name%.png}"
  PATH_URL="/${REPO}/raw/${BRANCH}/${SCREENSHOTS_REL}/${name}.png"
  echo "[${name}](${PATH_URL})"
  echo ""
done
