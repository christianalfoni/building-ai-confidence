#!/usr/bin/env bash
# Fetches Vercel build logs for the current git branch's latest deployment.
# Requires: VERCEL_TOKEN, VERCEL_PROJECT_ID, VERCEL_TEAM_ID

set -euo pipefail

VERCEL_TOKEN="${VERCEL_TOKEN:?VERCEL_TOKEN is not set}"
VERCEL_PROJECT_ID="${VERCEL_PROJECT_ID:?VERCEL_PROJECT_ID is not set}"
VERCEL_TEAM_ID="${VERCEL_TEAM_ID:?VERCEL_TEAM_ID is not set}"

BRANCH=$(git branch --show-current)
if [[ -z "$BRANCH" ]]; then
  echo "Error: could not determine current git branch" >&2
  exit 1
fi

echo "Fetching latest deployment for branch: $BRANCH"

RESPONSE=$(curl -sf \
  "https://api.vercel.com/v6/deployments?projectId=${VERCEL_PROJECT_ID}&teamId=${VERCEL_TEAM_ID}&gitBranch=${BRANCH}&limit=1&target=preview" \
  -H "Authorization: Bearer ${VERCEL_TOKEN}")

DEPLOYMENT_ID=$(echo "$RESPONSE" | node -e "
  let data = '';
  process.stdin.on('data', d => data += d);
  process.stdin.on('end', () => {
    const obj = JSON.parse(data);
    const deployments = obj.deployments;
    if (!deployments || deployments.length === 0) {
      console.error('No deployments found for this branch');
      process.exit(1);
    }
    console.log(deployments[0].uid);
  });
")

echo "Deployment: $DEPLOYMENT_ID"
echo ""
echo "Build logs:"
echo "──────────────────────────────────────────────────────────────"

curl -sf \
  "https://api.vercel.com/v3/deployments/${DEPLOYMENT_ID}/events?builds=1&teamId=${VERCEL_TEAM_ID}" \
  -H "Authorization: Bearer ${VERCEL_TOKEN}" | node -e "
    let data = '';
    process.stdin.on('data', d => data += d);
    process.stdin.on('end', () => {
      const lines = data.trim().split('\n').filter(Boolean);
      for (const line of lines) {
        try {
          const event = JSON.parse(line);
          if (event.type === 'command') process.stdout.write('\$ ' + (event.payload?.text ?? '') + '\n');
          else if (event.type === 'stdout' || event.type === 'stderr') process.stdout.write(event.payload?.text ?? '');
        } catch {}
      }
    });
  "
