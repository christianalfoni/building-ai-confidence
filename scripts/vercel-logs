#!/usr/bin/env bash
# Fetches Vercel deployment logs for the current git branch.
# Requires: VERCEL_TOKEN, VERCEL_PROJECT_ID, VERCEL_TEAM_ID

set -euo pipefail

VERCEL_TOKEN="${VERCEL_TOKEN:?VERCEL_TOKEN is not set}"
VERCEL_PROJECT_ID="${VERCEL_PROJECT_ID:?VERCEL_PROJECT_ID is not set}"
VERCEL_TEAM_ID="${VERCEL_TEAM_ID:?VERCEL_TEAM_ID is not set}"

BRANCH=$(git branch --show-current)
if [[ -z "$BRANCH" ]]; then
  echo "Error: could not determine current git branch" >&2
  exit 1
fi

echo "Fetching latest deployment for branch: $BRANCH"

RESPONSE=$(curl -sf \
  "https://api.vercel.com/v6/deployments?projectId=${VERCEL_PROJECT_ID}&teamId=${VERCEL_TEAM_ID}&gitBranch=${BRANCH}&limit=1&target=preview" \
  -H "Authorization: Bearer ${VERCEL_TOKEN}")

DEPLOYMENT_URL=$(echo "$RESPONSE" | node -e "
  let data = '';
  process.stdin.on('data', d => data += d);
  process.stdin.on('end', () => {
    const deployments = JSON.parse(data).deployments;
    if (!deployments || deployments.length === 0) {
      console.error('No deployments found for this branch');
      process.exit(1);
    }
    console.log('https://' + deployments[0].url);
  });
")

echo "Deployment: $DEPLOYMENT_URL"
echo ""

npx vercel logs "$DEPLOYMENT_URL" --token "$VERCEL_TOKEN"
