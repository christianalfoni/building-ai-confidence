#!/usr/bin/env node
// Syncs Doppler secrets to Vercel environment variables (production + preview).
// Run this after adding or changing secrets in Doppler.
// Requires: VERCEL_TOKEN, VERCEL_PROJECT_ID, VERCEL_TEAM_ID in the environment (from Doppler).

import { execSync } from 'node:child_process';

const token = process.env.VERCEL_TOKEN ?? die('VERCEL_TOKEN is not set');
const projectId = process.env.VERCEL_PROJECT_ID ?? die('VERCEL_PROJECT_ID is not set');
const teamId = process.env.VERCEL_TEAM_ID ?? die('VERCEL_TEAM_ID is not set');

// Present in Doppler for local tooling — must not be pushed to Vercel
const SKIP = new Set([
  'DOPPLER_CONFIG', 'DOPPLER_ENVIRONMENT', 'DOPPLER_PROJECT',
  'VERCEL_TOKEN', 'VERCEL_PROJECT_ID', 'VERCEL_TEAM_ID',
]);

function die(msg) { console.error('Error:', msg); process.exit(1); }

function vFetch(path, opts = {}) {
  const sep = path.includes('?') ? '&' : '?';
  return fetch(`https://api.vercel.com${path}${sep}teamId=${teamId}`, {
    ...opts,
    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...opts.headers },
  });
}

console.log('Fetching secrets from Doppler...');
const secrets = JSON.parse(execSync('doppler secrets download --no-file --format json', { encoding: 'utf8' }));

console.log('Fetching existing Vercel env vars...');
const existingRes = await vFetch(`/v10/projects/${projectId}/env?limit=100`);
if (!existingRes.ok) die(`Failed to fetch Vercel env vars: ${await existingRes.text()}`);
const { envs = [] } = await existingRes.json();
const existingById = Object.fromEntries(envs.map(e => [e.key, e]));

const TARGETS = ['production', 'preview'];

for (const [key, value] of Object.entries(secrets)) {
  if (SKIP.has(key)) continue;
  const existing = existingById[key];
  if (existing) {
    const res = await vFetch(`/v10/projects/${projectId}/env/${existing.id}`, {
      method: 'PATCH',
      body: JSON.stringify({ value, target: TARGETS }),
    });
    if (!res.ok) die(`Failed to update ${key}: ${await res.text()}`);
    console.log(`  updated  ${key}`);
  } else {
    const res = await vFetch(`/v10/projects/${projectId}/env`, {
      method: 'POST',
      body: JSON.stringify({ key, value, target: TARGETS, type: 'encrypted' }),
    });
    if (!res.ok) die(`Failed to create ${key}: ${await res.text()}`);
    console.log(`  created  ${key}`);
  }
}

console.log('Done.');
