#!/usr/bin/env bash
# Sets up a fresh branch from the latest main and creates the work folder.
# Usage: ./scripts/start-work <branch-name>

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Error: branch name required." >&2
  echo "Usage: ./scripts/start-work <branch-name>" >&2
  exit 1
fi

BRANCH="$1"
DATE=$(date +%Y_%m_%d)
# Sanitize branch name for use as a directory name (replace / with -)
FOLDER_BRANCH="${BRANCH//\//-}"
WORK_DIR="work/${DATE}_${FOLDER_BRANCH}"

echo "Switching to main and pulling latest…"
git checkout main
git pull

echo "Creating branch '${BRANCH}'…"
git checkout -b "${BRANCH}"

echo "Creating work folder '${WORK_DIR}'…"
mkdir -p "${WORK_DIR}"

echo ""
echo "Ready."
echo "  Branch:      ${BRANCH}"
echo "  Work folder: ${WORK_DIR}"
