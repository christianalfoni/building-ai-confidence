#!/usr/bin/env node

import { chromium } from "playwright";
import { createServer } from "vite";
import { mkdir } from "fs/promises";
import { resolve } from "path";
import { execSync } from "child_process";
import { readdirSync } from "fs";

const [component, story] = process.argv.slice(2);

if (!component || !story) {
  console.error("Usage: scripts/screenshot <platform/Component> <story>");
  console.error("  e.g. scripts/screenshot desktop/App withTodos");
  console.error("  e.g. scripts/screenshot mobile/App withTodos");
  process.exit(1);
}

const [platform] = component.split("/");

const viewports = {
  desktop: { width: 1280, height: 800 },
  mobile: { width: 390, height: 844 },
};

const viewport = viewports[platform];

if (!viewport) {
  console.error(`Unknown platform "${platform}". Use "desktop" or "mobile".`);
  process.exit(1);
}

const root = new URL("..", import.meta.url).pathname;
const workDir = resolve(root, "work");

// Resolve the work folder for the current branch
const branch = execSync("git branch --show-current", { cwd: root }).toString().trim();
const branchSafe = branch.replace(/\//g, "-");
const branchSuffix = `_${branchSafe}`;

let entries;
try {
  entries = readdirSync(workDir, { withFileTypes: true });
} catch {
  console.error(`Error: work/ directory not found. Run ./scripts/start-work <branch-name> first.`);
  process.exit(1);
}

const match = entries.find((e) => e.isDirectory() && e.name.endsWith(branchSuffix));
if (!match) {
  console.error(`Error: no work folder found for branch '${branch}'. Run ./scripts/start-work <branch-name> first.`);
  process.exit(1);
}

const workFolder = resolve(workDir, match.name);
const outDir = resolve(workFolder, "screenshots");
await mkdir(outDir, { recursive: true });

const server = await createServer({ root, server: { port: 5199 } });
await server.listen();

const slug = component.replace("/", "-");
const url = `http://localhost:5199/stories.html?component=${encodeURIComponent(component)}&story=${story}`;
const outFile = resolve(outDir, `${slug}-${story}.png`);

const browser = await chromium.launch();
const page = await browser.newPage();
await page.setViewportSize(viewport);
await page.goto(url);
await page.waitForLoadState("networkidle");
await page.screenshot({ path: outFile, fullPage: false });

await browser.close();
await server.close();

console.log(outFile);
